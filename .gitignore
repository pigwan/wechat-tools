# ===== 二进制 / 运行时 / 第三方依赖（体积大，不入库）=====
runtime/
vendor/
frp/

# ===== 通用 Python 缓存与编译产物 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ===== 日志与临时文件 =====
*.log
*.lock

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== WorkBuddy 工具数据（非项目源码：含自动备份/记忆，勿入库）=====
.workbuddy/
.wbapp_*.genie

# ===== 隐藏运行时目录（含 node_modules / 浏览器 profile / 缓存，勿入库）=====
.runtime/

# ===== 本地私有配置（含 API Key / 令牌 / 群 ID，绝不入库）=====
*.local.json

# ===== 采集与运行产生的缓存/数据（可从源码重新生成）=====
wechat-report-bridge/admin/.thumbs/
wechat-report-bridge/admin/social_data.json
wechat-report-bridge/admin/social_status.json
wechat-report-bridge/alert_heartbeat.json
